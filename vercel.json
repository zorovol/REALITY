{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/floor/**/*.js": {
      "includeFiles": "api/lib/floorStore.js"
    }
  },
  "rewrites": [
    { "source": "/socket.io", "destination": "https://tickwire-api.onrender.com/socket.io" },
    { "source": "/socket.io/(.*)", "destination": "https://tickwire-api.onrender.com/socket.io/$1" },
    { "source": "/api/floor/:path*", "destination": "/api/floor/:path*" },
    { "source": "/api/:path*", "destination": "https://tickwire-api.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
