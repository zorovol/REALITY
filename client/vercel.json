{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/socket.io", "destination": "https://ai-drama-island-api.onrender.com/socket.io" },
    { "source": "/socket.io/(.*)", "destination": "https://ai-drama-island-api.onrender.com/socket.io/$1" },
    { "source": "/api/(.*)", "destination": "https://ai-drama-island-api.onrender.com/api/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ]
}
