# ── Database (Neon PostgreSQL / Vercel Postgres) ─────────────────────────────
DATABASE_URL=

# ── AI Providers (all optional) ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SHOW_SPEED=1

# ── Solana (REAL on-chain trading — mainnet = real money) ────────────────────
# Use a dedicated RPC (Helius, QuickNode, etc.) for production mainnet.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Required for encrypting agent wallet secret keys at rest (server-side only).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Set true ONLY for local dev without funded wallets (mock balances, no txs).
SIMULATION_FALLBACK=false

# Minimum SOL balance before agents attempt trades / token launches
MIN_SOL_FOR_TRADE=0.1
MIN_SOL_FOR_LAUNCH=0.2

# Safety: max on-chain txs per agent per minute
MAX_TRADES_PER_MINUTE=2
TRADE_INTERVAL_MS=45000
BALANCE_REFRESH_MS=15000

# Admin panel — password to view agent wallet private keys in the UI
# Generate a strong password; never commit .env to git
ADMIN_PASSWORD=

# Optional comma-separated pump.fun mint addresses for agents to trade
PUMP_EXTRA_MINTS=
