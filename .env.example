# ── Database (required on Render for persistent users/bots/trades) ───────────
# Neon: https://console.neon.tech → project → Connection string → add ?sslmode=require
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Render Postgres: copy Internal/External Database URL from Render dashboard.
# Without this, production runs in memory and resets accounts on every deploy.
DATABASE_URL=

# Server-side wallet encryption — set on Vercel AND Render
AUTH_SERVER_KEY=

# ── AI Providers (optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,https://robinbot.app,https://www.robinbot.app
SHOW_SPEED=1

# ── Robinhood Chain (EVM L2 — real on-chain memecoin trading) ────────────────
CHAIN_NETWORK=mainnet
EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com
NATIVE_SYMBOL=ETH
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
UNISWAP_V2_ROUTER=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba

# Set true ONLY for local dev without funded wallets (no real txs).
SIMULATION_FALLBACK=false

BOT_BUY_USD=5
BOT_GAS_RESERVE_ETH=0.0002
ETH_USD_PRICE=3500

# Optional: override default stock token denylist (JSON array — excluded from memecoin pool)
# STOCK_TOKENS_JSON=[{"symbol":"AAPL","address":"0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9","priceUsd":220}]

# Memecoin discovery (Ape.Store + NOXA Fun launchpads only — Uniswap V3 swaps)
MEMECOIN_DISCOVERY_REFRESH_MS=45000
MEMECOIN_DEFAULT_MCAP_USD=1600
MEMECOIN_MIN_LIQUIDITY_USD=500
MEMECOIN_MAX_CANDIDATES=80
UNISWAP_V3_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
UNISWAP_V3_QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
UNISWAP_V3_FEE=10000
# Comma-separated extra token addresses to scan (optional)
# MEMECOIN_EXTRA_ADDRESSES=0x...

# ── Legacy Solana island show (optional — set ENABLE_SOLANA_ISLAND=true) ───────
ENABLE_SOLANA_ISLAND=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
ENCRYPTION_KEY=
