# ── Database (Neon PostgreSQL / Vercel Postgres) ─────────────────────────────
# Paste your Neon connection string here. On Vercel, add the Neon integration
# and copy the DATABASE_URL it generates (postgres://...neon.tech/...?sslmode=require)
# If left empty, the show still runs with in-memory persistence (state resets on restart).
DATABASE_URL=

# ── AI Providers (all optional — contestants fall back to the built-in persona engine) ──
# Any keys you add are automatically distributed across contestants for personality diversity.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Show pacing multiplier: 1 = normal, 2 = twice as fast, 0.5 = slower
SHOW_SPEED=1
