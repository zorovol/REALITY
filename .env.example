# ── Database (required on Render for persistent users/bots/trades) ───────────
DATABASE_URL=

# Server-side wallet encryption — set on Vercel AND Render
AUTH_SERVER_KEY=

# ── AI Providers (optional) ──────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,https://tickwire.app,https://www.tickwire.app
SHOW_SPEED=1

# ── Ethereum mainnet (tokenized stock trading via Uniswap V3) ────────────────
EVM_RPC_URL=https://ethereum.publicnode.com
CHAIN_ID=1
CHAIN_NAME=Ethereum
CHAIN_EXPLORER_URL=https://etherscan.io
NATIVE_SYMBOL=ETH
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
UNISWAP_V3_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
UNISWAP_V3_QUOTER=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
UNISWAP_V3_FEE=3000

# Set true ONLY for local dev without funded wallets (no real txs).
SIMULATION_FALLBACK=false

BOT_BUY_USD=15
BOT_GAS_RESERVE_ETH=0.005
ETH_USD_PRICE=2500

# Stock discovery (Ondo / xStocks on Ethereum)
STOCK_DISCOVERY_REFRESH_MS=90000
STOCK_MIN_LIQUIDITY_USD=1000
BOT_MAX_HOLD_MS=900000

# ── Legacy Solana island show (optional) ─────────────────────────────────────
ENABLE_SOLANA_ISLAND=false
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
ENCRYPTION_KEY=
