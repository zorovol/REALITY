# ── Database (Neon PostgreSQL / Vercel Postgres) ─────────────────────────────
# Required for user signup/login and bot persistence in production.
DATABASE_URL=

# Server-side wallet encryption — set on Vercel AND Render
AUTH_SERVER_KEY=

# Optional: Neon Postgres for user/bot persistence (set on Vercel for signup)

# ── AI Providers (all optional) ──────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,https://tickwire.app,https://www.tickwire.app
SHOW_SPEED=1

# ── Solana (REAL on-chain trading — mainnet = real money) ────────────────────
# Use a dedicated RPC (Helius, QuickNode, etc.) for production mainnet.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Required for encrypting agent wallet secret keys at rest (server-side only).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Set true ONLY for local dev without funded wallets (mock balances, no txs).
SIMULATION_FALLBACK=false

# Minimum SOL balance before agents attempt trades / token launches
MIN_SOL_FOR_TRADE=0.02
MIN_SOL_FOR_LAUNCH=0.2

# Scalping: fixed $ per buy/sell, fast in-and-out
TRADE_USD_PER_SIDE=2
MAX_TRADES_PER_MINUTE=30
TRADE_INTERVAL_MS=2000
BALANCE_REFRESH_MS=5000
TRADE_SELL_AFTER_BUY_MS=20000

# Optional comma-separated pump.fun mint addresses for agents to trade
PUMP_EXTRA_MINTS=

# Auto-discover live pump.fun tokens (bonding curve) for bots to buy/sell
PUMP_DISCOVERY=true
PUMP_DISCOVERY_REFRESH_MS=60000

# Target ~$4k market cap coins; each bot gets a unique mint per tick
PUMP_TARGET_MCAP_USD=4000
PUMP_MCAP_MIN_USD=2500
PUMP_MCAP_MAX_USD=6000

# Set true only if you want bots to launch their own island coins
PUMP_AUTO_LAUNCH=false
